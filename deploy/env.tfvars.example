region = "us-east-1"
tenant = "acme"
env    = "prod"
azs    = ["us-east-1a", "us-east-1b"]

# Required. Replace with the public IPv4 CIDRs of authorized workstations/VPNs.
# (Ignored when enable_cloudfront = true — the ALB is then locked to CloudFront.)
alb_ingress_cidrs = ["REPLACE_WITH_YOUR_PUBLIC_IP/32"]

# HTTP-only for this validation deploy (no ACM cert). Switch to HTTPS for prod,
# OR set enable_cloudfront = true below to get edge TLS with no ACM cert.
allow_plaintext_alb = true

# CloudFront in front of the ALB (issue #5): edge HTTPS on the default
# *.cloudfront.net cert (no ACM cert/DNS needed) and locks the ALB so only this
# distribution can reach it. Clients then use the cloudfront_url output.
# Leave false to keep the IP-allowlist posture above.
enable_cloudfront = false
# cloudfront_origin_read_timeout = 60          # raise toward 180 if first-token latency is high
# cloudfront_price_class         = "PriceClass_100"

ui_password = "REPLACE-with-a-strong-password"

# minimal size
gateway_desired_count = 1
redis_num_replicas    = 0
db_instance_class     = "db.t4g.medium" # Aurora PG floor
db_engine_version     = "16.13"          # valid Aurora PG in us-east-1 (16.4 not offered)
skip_final_snapshot   = true
s3_force_destroy      = true

# Models are NOT listed here — `register-models.sh` discovers and registers them
# after install (Claude via global/us inference profiles, gpt-oss, and Codex on
# Mantle). Pricing uses LiteLLM's built-in map; the script pins only the Codex
# route that LiteLLM doesn't price (AWS-sourced — see register-models.sh).
proxy_config = {
  model_list = []
  litellm_settings = {
    drop_params                        = true
    route_all_chat_openai_to_responses = true
  }
  general_settings = {
    # fail_closed=false (LiteLLM default): caps still enforce; avoids hard-
    # rejecting keys when a spend counter is momentarily unverifiable.
    fail_closed_budget_enforcement = false
    # REQUIRED for register-models.sh to work: the module sets STORE_MODEL_IN_DB
    # only on the backend container, NOT the serving gateway — so DB-registered
    # models (/model/new) never load into /v1/models and nothing serves (#13).
    # Setting it here (config read by both containers) makes the gateway load
    # DB models. Without it, register-models.sh reports success but the gateway
    # has zero usable models. (Alternatively, list models inline in model_list.)
    store_model_in_db = true
  }
}

# ── Codex feature switch ─────────────────────────────────────────────────────
# Codex/gpt-5.x is ON by default, alongside Claude. You do NOT create any secret:
# the installer mints the short-lived Bedrock API key, stores it, and a built-in
# Lambda rotates it (~12h TTL). Nothing to configure here for a Codex + Claude
# gateway — leave these at their defaults.
enable_codex             = true   # Claude + Codex out of the box

# How the Codex/Mantle Bedrock key is REFRESHED — ONE front-door choice (#76).
# The choice is about the refresh PROCESS, not the key's lifespan:
#   lambda_auto_refresh (default)  Terraform deploys a built-in Lambda that re-mints
#                                  the key. Fully automatic — nothing else to do.
#   external_cron_auto_refresh     Terraform deploys NO refresher. You point the
#                                  gateway at a Secrets Manager key ARN (below) and
#                                  re-mint it with YOUR OWN cron (see
#                                  docs/codex-cron-key-refresh.md). Use this if your
#                                  org SCP blocks lambda:CreateFunction.
codex_key_mode           = "lambda_auto_refresh"
enable_codex_key_refresh = true   # installer-minted key auto-rotates (lambda mode)
# codex_key_refresh_hours = 6     # optional; must be < the ~12h TTL

# Claude-only install: set enable_codex = false. No Codex key is minted or needed.

# No-Lambda org: set codex_key_mode = "external_cron_auto_refresh" and provide the
# ARN below; the gateway uses it verbatim, Terraform deploys no refresher, and your
# own cron re-mints a short-term key into it (docs/codex-cron-key-refresh.md).
# gateway_extra_secrets = {
#   BEDROCK_API_KEY = "arn:aws:secretsmanager:$REGION:$ACCOUNT_ID:secret:...-bedrock-api-key-XXXXXX"
# }
# ─────────────────────────────────────────────────────────────────────────────

# Pin LiteLLM software to latest stable (module default is an older -dev image).
image_tag = "v1.92.0"
