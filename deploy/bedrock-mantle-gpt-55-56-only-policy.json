{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBedrockMantleBearerTokenUse",
      "Effect": "Allow",
      "Action": "bedrock-mantle:CallWithBearerToken",
      "Resource": "*"
    },
    {
      "Sid": "AllowApprovedMantleModels",
      "Effect": "Allow",
      "Action": "bedrock-mantle:CreateInference",
      "Resource": "arn:aws:bedrock-mantle:*:${aws:PrincipalAccount}:project/*",
      "Condition": {
        "StringEquals": {
          "bedrock-mantle:Model": [
            "openai.gpt-5.5",
            "openai.gpt-5.6-sol",
            "openai.gpt-5.6-terra",
            "openai.gpt-5.6-luna"
          ]
        }
      }
    },
    {
      "Sid": "DenyAllOtherMantleModels",
      "Effect": "Deny",
      "Action": "bedrock-mantle:CreateInference",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "bedrock-mantle:Model": [
            "openai.gpt-5.5",
            "openai.gpt-5.6-sol",
            "openai.gpt-5.6-terra",
            "openai.gpt-5.6-luna"
          ]
        }
      }
    }
  ]
}
