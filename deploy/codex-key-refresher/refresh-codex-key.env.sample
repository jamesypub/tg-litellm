# Config for refresh-codex-key.sh (no-Lambda Codex key refresher, #84/#92).
# Copy to refresh-codex-key.env next to the wrapper and fill in YOUR values:
#     cp refresh-codex-key.env.sample refresh-codex-key.env
#     chmod 600 refresh-codex-key.env      # contains no secret, but keep it owner-only
# Every value here is injected, never baked into the script. Precedence when a
# var is BOTH exported and set in this file: THE ENVIRONMENT WINS (the file only
# fills what is unset), so a cron/env override is never clobbered by a stale file.
#
# This file holds NO secret — only names/ARNs of resources you already own. The
# bearer token itself is minted at runtime from your AWS credentials and written
# straight to Secrets Manager; it never lands on disk here.

# AWS region of the gateway + Bedrock.
REGION=us-east-1

# Secrets Manager ARN the GATEWAY task reads for the Codex bearer key. This MUST
# be the exact ARN referenced by the gateway task definition — if the cron writes
# a different secret than the task reads, the roll serves a stale key (#86).
SECRET_ARN=arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:<your-codex-key-secret>

# Gateway ECS cluster + service names (typically <tenant>-litellm-<env> and
# <tenant>-litellm-<env>-gateway).
ECS_CLUSTER=<tenant>-litellm-<env>
ECS_SERVICE=<tenant>-litellm-<env>-gateway

# Credential mode for the cron process (cron does NOT inherit your interactive
# AWS_PROFILE):
#   instance_role -> the host EC2 instance role supplies creds; export nothing
#                    (the wrapper neutralizes any inherited AWS_* to avoid minting
#                     under a leaked identity).
#   profile       -> a named profile in ~/.aws/config supplies creds; also set
#                    AWS_PROFILE below.
CRED_MODE=instance_role

# Only when CRED_MODE=profile. Leave unset/commented for instance_role.
# AWS_PROFILE=your-profile-name
