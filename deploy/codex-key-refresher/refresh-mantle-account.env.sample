# Config for refresh-mantle-account.sh (multi-account Mantle token refresher, #128).
# Copy to refresh-mantle-account.env next to the wrapper and fill in YOUR values:
#     cp refresh-mantle-account.env.sample refresh-mantle-account.env
#     chmod 600 refresh-mantle-account.env
# Environment wins over this file — an exported var is never overwritten.

# AWS region of Bedrock + Secrets Manager.
REGION=us-east-1

# Secrets Manager ARN in the GATEWAY account to write this account's token into.
# Must match the env var the gateway reads (e.g. BEDROCK_API_KEY_DEMO0 secret ARN).
SECRET_ARN="arn:aws:secretsmanager:us-east-1:<GATEWAY_ACCOUNT_ID>:secret:<your-secondary-key-secret>"

# Gateway URL and admin key — used to inject the fresh token into the running
# LiteLLM process via POST /config/update (no ECS restart; live in ~30s).
# This keeps the gateway's DB value in sync with Secrets Manager (#132).
LITELLM_URL="https://<your-cloudfront-domain>"
LITELLM_MASTER_KEY="sk-<your-master-key>"

# Env var name the gateway reads for this account's bearer key.
# Must match what tgw add-account used (e.g. BEDROCK_API_KEY_DEMO0 for prefix=demo0).
BEDROCK_API_KEY_ENV="BEDROCK_API_KEY_<PREFIX>"

# Credential mode for the cron process:
#   instance_role -> EC2 instance role supplies creds (credential_source = Ec2InstanceMetadata)
#   profile       -> named AWS profile; also set AWS_PROFILE below
#
# TOKEN LIFETIME: the bearer key is a 12h SigV4 presign but cannot outlive the
# signing session. For profile mode, set duration_seconds = 43200 in ~/.aws/config
# AND ensure the role's MaxSessionDuration >= 43200. See docs/codex-cron-key-refresh.md §8.
CRED_MODE=profile

# Only when CRED_MODE=profile. Leave unset/commented for instance_role.
AWS_PROFILE="<your-secondary-account-profile>"

# Whether to restart ECS after writing the token.
#   false -> write token only (secondary account; primary account's refresher restarts ECS)
#   true  -> write token AND restart ECS (use only on the LAST / primary account)
UPDATE_ECS=false

# Required only when UPDATE_ECS=true.
# ECS_CLUSTER=<tenant>-litellm-<env>
# ECS_SERVICE=<tenant>-litellm-<env>-gateway
