# Copy to .env and fill in. The container reads these to wire Claude Code + Codex.
# Nothing here is baked into the image; .env is gitignored.

# Your gateway URL (from your admin) — no trailing slash needed.
GATEWAY_URL=https://your-gateway.example.com

# Your personal virtual key (sk-...) issued by the gateway admin.
LITELLM_KEY=sk-REPLACE-ME

# Model names as registered on the gateway (ask your admin which are available).
# CODEX_MODEL must be the EXACT canonical Mantle ID Codex sends (e.g.
# openai.gpt-5.6-sol) and must be in your key's allowlist (#30).
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_FAST_MODEL=claude-haiku-4-5
CODEX_MODEL=openai.gpt-5.5
